# KRISTOU SCHOOL environment template
#
# Placeholder names only. Never commit real secrets.
# packages/config is the authority for variables already consumed by runtime code.

# Explicit KRISTOU environment selection.
# Security behavior must not be inferred from NODE_ENV alone.
APP_ENV=local
VITE_APP_ENV=local

# Database / transient infrastructure
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://HOST:6379

# Origins / public client configuration
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# Web sessions
SESSION_COOKIE_NAME=kristou_session
SESSION_TOKEN_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Telegram — reserved until the account-linking/runtime slice is ready.
# Never expose the bot token to browser/client code.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_SECRET
TELEGRAM_BOT_USERNAME=REPLACE_WITH_BOT_USERNAME
TELEGRAM_BOT_ID=REPLACE_WITH_BOT_ID
# Must resolve to the canonical KRISTOU Web frontend entry/route. It is not authority for a second Telegram frontend.
MINI_APP_URL=REPLACE_WITH_MINI_APP_URL

# Object storage — planned media foundation; exact provider may evolve.
OBJECT_STORAGE_ENDPOINT=REPLACE_WITH_ENDPOINT
OBJECT_STORAGE_REGION=REPLACE_WITH_REGION
OBJECT_STORAGE_BUCKET=REPLACE_WITH_BUCKET
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_SECRET
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET

# Optional Cloudflare / AI — later phase only. Keep unset until implemented.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=

# Optional logging/observability variables are TBD when runtime tooling is chosen.
